{
  "name": "online-pen",
  "version": "0.1.3",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint app lib proxy.ts --max-warnings 0",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:studio": "node ./node_modules/prisma/build/index.js studio",
    "seed": "tsx prisma/seed.ts",
    "test:buttons": "node scripts/button-audit.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "next typegen && tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "next": "16.4.3",
    "prisma": "^5.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
